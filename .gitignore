# Игнорируем все файлы с расширением .log
*.log

# Игнорируем папку с кэшем Python
__pycache__/

# Игнорируем временные файлы
*.tmp
*.temp

# Игнорируем файлы с данными (часто большие, их не хранят в Git)
*.csv
*.xlsx
*.json
data/

# Игнорируем виртуальное окружение (оно у каждого своё)
venv/
.venv/
env/

# Игнорируем файлы IDE (например, от PyCharm или VS Code)
.idea/
.vscode/
*.swp
*.swo

# Игнорируем системный файл macOS
.DS_Store

.env

tmp_data.txt
